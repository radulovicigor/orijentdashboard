# ---- Pristup dashboardu -------------------------------------------------
# Lozinka koju klijent unosi jednom (middleware.ts + app/api/login)
DASHBOARD_PASSWORD=

# ---- Supabase (izvor Meta Ads podataka) ---------------------------------
# Meta podaci se NE citaju direktno sa Mete. Jednom dnevno se sinhronizuju
# u Supabase (tabele public.meta_daily i public.meta_snapshot), a app cita odatle
# preko PostgREST-a. Vidi CLAUDE.md, sekcija "Odakle dolaze podaci".
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=

# ---- Shopify (cita se uzivo) --------------------------------------------
SHOPIFY_STORE_DOMAIN=xxxx.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# alternativa: stari shpat_ token umjesto client_id/secret
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ---- Opcionalno ---------------------------------------------------------
# Prosjecna bruto marza (0.45 = 45%) — ako je postavljena, prikazuje se
# procijenjeni profit i ROI. Ako nije, te dvije metrike se sakriju.
GROSS_MARGIN=

# ---- Ako ikad dobijes Meta token (nije trenutno u upotrebi) -------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=976499834476142
META_API_VERSION=v23.0
